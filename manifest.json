{
  "manifest_version": 3,
  "name": "ChatGPT Smart Ping",
  "version": "1.0.0",
  "description": "Smart completion pings for ChatGPT responses.",
  "permissions": [
    "storage",
    "offscreen",
    "notifications"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Ping settings"
  }
}